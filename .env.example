# Copy to .env / .env.local / .dev.vars (gitignored). Never commit real values.

# --- Client (Vite build) ---
# Google Tag Manager container ID (optional). Empty = GTM/GA off.
# VITE_GTM_ID=GTM-XXXXXXX

# Live menu API base (default /api/live)
# VITE_LIVE_API_BASE=/api/live

# --- Live proxy (Vite dev middleware + Cloudflare Pages Functions) ---
# Required for KFC UK adapter. Use the public browser x-api-key from kfc.co.uk order flow
# (DevTools → Network → request headers). Do not commit the value.
KFC_API_KEY=

# Optional KFC overrides
# KFC_API_BASE=https://prod.kfcapi.com/api/v3
# KFC_MENU_OUTPUT_BASE=https://menuoutput.prod.platform.kfcapi.com
# KFC_MENU_UPSTREAM=
# KFC_STORES_UPSTREAM=

# Optional Popeyes overrides
# POPEYES_API_BASE=
# POPEYES_MENU_UPSTREAM=
# POPEYES_STORES_UPSTREAM=
