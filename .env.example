# Copy to .env / .env.local / .dev.vars (gitignored). Never commit real values.

# --- Client (Vite build) ---
# These are baked into the SPA at `npm run build`.

# Google Tag Manager container ID (optional). Leave empty to disable GTM.
# Example: VITE_GTM_ID=GTM-XXXXXXX
VITE_GTM_ID=

# Google Search Console HTML meta verification (optional).
# Use the content= value from the meta tag Google shows you.
# Example: VITE_GOOGLE_SITE_VERIFICATION=AbCdEf123...
VITE_GOOGLE_SITE_VERIFICATION=

# “Buy me a pint” support link (optional). Leave empty to hide the UI.
# Example: VITE_BUY_ME_A_PINT_URL=https://buymeacoffee.com/your-slug
VITE_BUY_ME_A_PINT_URL=
# Optional custom button image; if empty, BMC slug URLs get a default button image.
# VITE_BUY_ME_A_PINT_IMG=

# Live menu API base (default /api/live)
# VITE_LIVE_API_BASE=/api/live

# --- Live proxy (Vite dev middleware + Cloudflare Pages Functions) ---
# Optional. Public browser x-api-key from kfc.co.uk order flow (DevTools → Network).
# If unset, the live adapter discovers the current SPA key from kfc.co.uk at request time.
# Set this if auto-discovery is blocked. Do not commit the value.
KFC_API_KEY=

# Optional KFC overrides
# KFC_API_BASE=https://prod.kfcapi.com/api/v3
# KFC_MENU_OUTPUT_BASE=https://menuoutput.prod.platform.kfcapi.com
# KFC_MENU_UPSTREAM=
# KFC_STORES_UPSTREAM=

# Optional Popeyes overrides
# POPEYES_API_BASE=
# POPEYES_MENU_UPSTREAM=
# POPEYES_STORES_UPSTREAM=

# Optional McDonald’s / Burger King upstream overrides
# MCD_STORES_UPSTREAM=
# MCD_MENU_UPSTREAM=
# BK_STORES_UPSTREAM=
# BK_MENU_UPSTREAM=
